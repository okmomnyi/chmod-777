# Neon Postgres pooled connection string (from Neon dashboard)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Telegram bot and allowlist (comma-separated Telegram numeric user IDs)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# At least one LLM provider key is required. Both are used for failover.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Defaults use OpenRouter's free-model router and NVIDIA's hosted NIM endpoint.
# Optional model overrides:
# OPENROUTER_CHEAP_MODEL=openrouter/free
# OPENROUTER_SMART_MODEL=openai/gpt-oss-20b:free
# NVIDIA_CHEAP_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_SMART_MODEL=nvidia/nemotron-3-super-120b-a12b
